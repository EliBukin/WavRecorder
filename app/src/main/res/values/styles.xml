<resources>
    <!-- Surfaces -->
    <style name="Widget.WavRecorder.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
    </style>

    <!-- Buttons: one filled primary action per state, outlined secondary actions. Every one keeps
         at least a 48dp touch target, and wraps its height rather than clipping larger text. -->
    <style name="Widget.WavRecorder.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/primary_action_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="Widget.WavRecorder.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
    </style>

    <!-- One segment of the split-duration choice: narrow horizontal padding so three segments fit
         a 320dp screen at large font scales without clipping. -->
    <style name="Widget.WavRecorder.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="cornerRadius">@dimen/corner_button</item>
    </style>

    <style name="Widget.WavRecorder.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.WavRecorder.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.WavRecorder.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Tabular figures keep the ticking elapsed time from jittering sideways. -->
    <style name="TextAppearance.WavRecorder.Elapsed" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
