<?xml version="1.0" encoding="utf-8"?>
<!-- The root stays the row's single interaction/accessibility target (click, long-press, selected
     state description - see RecordingsAdapter); rowCard mirrors its activated state
     (duplicateParentState) for the selected styling. dateHeader is presentation-only: shown on the
     first row of each date group, it never changes the list's order or item identity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_xs"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_xs"
        android:paddingBottom="@dimen/space_sm"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Today"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/rowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_recording_row"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/activeAccent"
            android:layout_width="@dimen/row_accent_width"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="?attr/colorPrimary"
            android:importantForAccessibility="no"
            android:visibility="invisible" />

        <!-- Shown only while bulk-selection mode is active (see RecordingsAdapter); the whole row is
             the actual tap target in that mode (isClickable=false here on purpose) — this is purely
             the visual indicator, so its own touch-target size doesn't need to individually meet the
             48dp minimum the row as a whole already comfortably exceeds. importantForAccessibility=no
             since the row itself now carries a localized selected/not-selected state description (see
             RecordingsAdapter) — without this, TalkBack's default "speak children" fallback would
             announce this checkbox's own static "Select recording" description right alongside that,
             redundantly. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/selectionCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:clickable="false"
            android:contentDescription="@string/selection_checkbox_description"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:id="@+id/fileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/fileMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/seekRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/speedButton"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_playback_speed"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        app:chipMinHeight="32dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Per-row actions. Collapsed (GONE) as a whole in selection mode so the title gets the
             full width back; see RecordingsAdapter. -->
        <LinearLayout
            android:id="@+id/rowActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target">

                <ImageButton
                    android:id="@+id/playButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/play_button_description"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />

                <ProgressBar
                    android:id="@+id/preparingIndicator"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

            <ImageButton
                android:id="@+id/overflowButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
